/* =================================================================
 * Waybar CSS Style for Hyprland
 * Recommended Font: JetBrainsMono Nerd Font
 * ================================================================= */

* {
    font-family: "JetBrainsMono Nerd Font";
    font-size: 13px;
    font-weight: bold;
    min-height: 0;
}

/* Main Bar Background */
window#waybar {
    background-color: rgba(26, 27, 38, 0.85); /* Semi-transparent dark */
    border-bottom: 2px solid rgba(122, 162, 247, 0.2);
    color: #c0caf5;
    transition-property: background-color;
    transition-duration: .5s;
}

window#waybar.hidden {
    opacity: 0.2;
}

/* Tooltips */
tooltip {
    background: #1a1b26;
    border: 1px solid #7aa2f7;
    border-radius: 8px;
}

tooltip label {
    color: #c0caf5;
}

/* =================================================================
 * Workspaces Module (Hyprland)
 * ================================================================= */
#workspaces {
    background: rgba(41, 46, 66, 0.6);
    margin: 5px 4px;
    padding: 0px 5px;
    border-radius: 8px;
    border: 1px solid rgba(122, 162, 247, 0.1);
}

#workspaces button {
    padding: 0px 5px;
    color: #7aa2f7;
    background: transparent;
    border-radius: 6px;
    transition: all 0.3s ease-in-out;
}

#workspaces button:hover {
    background: rgba(122, 162, 247, 0.2);
    color: #bb9af7;
}

#workspaces button.active {
    background: #7aa2f7;
    color: #1a1b26;
    border-radius: 6px;
    min-width: 25px;
}

#workspaces button.urgent {
    background: #f7768e;
    color: #1a1b26;
}

/* =================================================================
 * Common Module Styling (Pill Containers)
 * ================================================================= */
#window,
#clock,
#battery,
#cpu,
#memory,
#temperature,
#pulseaudio,
#network,
#tray,
#custom-launcher {
    background: rgba(41, 46, 66, 0.6);
    padding: 0px 10px;
    margin: 5px 3px;
    border-radius: 8px;
    color: #c0caf5;
    border: 1px solid rgba(122, 162, 247, 0.1);
}

/* Specific Adjustments */
#clock {
    color: #7dcfff;
}

#cpu {
    color: #9ece6a;
}

#memory {
    color: #e0af68;
}

#pulseaudio {
    color: #bb9af7;
}

#network {
    color: #7aa2f7;
}

#battery {
    color: #9ece6a;
}

#battery.charging {
    color: #9ece6a;
}

#battery.warning:not(.charging) {
    color: #e0af68;
}

#battery.critical:not(.charging) {
    background: #f7768e;
    color: #1a1b26;
    animation-name: blink;
    animation-duration: 0.5s;
    animation-timing-function: linear;
    animation-iteration-count: infinite;
    animation-direction: alternate;
}

/* Tray */
#tray {
    padding: 0px 8px;
}

#tray > .passive {
    -gtk-icon-effect: dim;
}

#tray > .needs-attention {
    -gtk-icon-effect: highlight;
    background: #f7768e;
}

/* Critical Battery Animation */
@keyframes blink {
    to {
        background-color: #1a1b26;
        color: #f7768e;
    }
}
